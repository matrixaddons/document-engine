msgid "Download counter"
msgstr ""

#: includes/Admin/DocsContent.php:317
msgid "Counts downloads (known bots are ignored)."
msgstr ""

#: includes/Admin/DocsContent.php:318
msgid "Accessible format request form; requests go to the email you set."
msgstr ""

#: includes/Admin/DocsContent.php:319
msgid "Library: layout, per page, View button, View opens"
msgstr ""

#: includes/Admin/DocsContent.php:319
msgid "Table, 20, on, page"
msgstr ""

#: includes/Admin/DocsContent.php:319
