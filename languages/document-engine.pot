msgid "Dates"
msgstr ""

#: includes/Admin/DocsContent.php:320
msgid "Short"
msgstr ""

#: includes/Admin/DocsContent.php:320
msgid "Short dates (Sep 25, 2026) or your site's date format in libraries, lists and cards."
msgstr ""

#: includes/Admin/DocsContent.php:321
#: includes/Admin/Upsell.php:252
msgid "Setting"
msgstr ""

#: includes/Admin/DocsContent.php:321
#: includes/Integrations/Elementor/ViewerWidget.php:54
#: includes/Integrations/Elementor/ViewerWidget.php:55
msgid "Default"
msgstr ""

#: includes/Admin/DocsContent.php:321
msgid "Effect"
msgstr ""

#: includes/Admin/DocsContent.php:323
msgid "Settings → PDF Viewer"
msgstr ""

#: includes/Admin/DocsContent.php:324
msgid "Default height (800px), initial zoom (fit width), and which toolbar parts show: toolbar (page navigation and zoom, switched together), download, print, full screen, search, sidebar. \"Version 1 blocks\" shows PDF blocks made with version 1 in the built-in viewer instead of Google's viewer. It is on for new installs; sites upgraded from version 1 keep Google's viewer until you switch it on (recommended: faster, and nothing is sent to Google)."
msgstr ""

#: includes/Admin/DocsContent.php:326
msgid "Settings → Post to PDF"
msgstr ""

#: includes/Admin/DocsContent.php:327
msgid "Button (post types, text, placement, alignment, download or open), Header & footer, Page & protection (orientation, text size, margins, PDF permissions), Style (theme styles, custom CSS) and, with Pro, Watermark. Pages are A4. The button appears only on the post types you tick."
msgstr ""

#: includes/Admin/DocsContent.php:329
msgid "Settings → Advanced"
msgstr ""

#: includes/Admin/DocsContent.php:331
msgid "<strong>Permissions</strong>: roles that manage, publish or draft documents."
msgstr ""

#: includes/Admin/DocsContent.php:332
msgid "<strong>PDF cache</strong> (on) and <strong>Generation limit</strong> (20 PDFs per visitor per minute) for Post to PDF."
msgstr ""

#: includes/Admin/DocsContent.php:333
msgid "<strong>When deleting the plugin</strong> (off): also delete documents, categories, settings and (with Pro) logs. Leave off unless you are removing the plugin for good."
msgstr ""

#: includes/Admin/DocsContent.php:336
msgid "Settings → Access & Pro, Fields, License"
msgstr ""

#: includes/Admin/DocsContent.php:338
msgid "Access"
msgstr ""

#: includes/Admin/DocsContent.php:338
msgid "Restricted documents in lists (lock or hide), protect files automatically (on), share link lifetime (7 days)."
msgstr ""

#: includes/Admin/DocsContent.php:339
#: includes/Admin/Upsell.php:256
msgid "Secure viewer"
msgstr ""

#: includes/Admin/DocsContent.php:339
msgid "Which documents use it (only where switched on / all restricted / all), watermark pattern, block downloads, stamp downloads."
msgstr ""

#: includes/Admin/DocsContent.php:340
msgid "Activity log"
msgstr ""

#: includes/Admin/DocsContent.php:340
msgid "Log activity, reading time, searches, logged-out visitors; keep entries for 365 days."
msgstr ""

#: includes/Admin/DocsContent.php:341
msgid "Office previews"
msgstr ""

