#: includes/Admin/DocsContent.php:299
msgid "Settings → PDF Viewer"
msgstr ""

#: includes/Admin/DocsContent.php:300
msgid "Default height (800px), initial zoom (fit width), and which toolbar buttons show: toolbar, download, print, full screen, search, sidebar. \"Version 1 blocks\" shows PDF blocks made with version 1 in the built-in viewer instead of Google's viewer. It is on for new installs; sites upgraded from version 1 keep Google's viewer until you switch it on (recommended: faster, and nothing is sent to Google)."
msgstr ""

#: includes/Admin/DocsContent.php:302
msgid "Settings → Post to PDF"
msgstr ""

#: includes/Admin/DocsContent.php:303
msgid "Button (post types, text, placement, alignment, download or open), Header & footer, Page & protection (orientation, text size, margins, PDF permissions), Style (theme styles, custom CSS) and Watermark. The button appears only on the post types you tick."
msgstr ""

#: includes/Admin/DocsContent.php:305
msgid "Settings → Advanced"
msgstr ""

#: includes/Admin/DocsContent.php:307
msgid "<strong>Permissions</strong>: roles that manage, publish or draft documents."
msgstr ""

#: includes/Admin/DocsContent.php:308
msgid "<strong>PDF cache</strong> (on) and <strong>Generation limit</strong> (20 PDFs per visitor per minute) for Post to PDF."
msgstr ""

#: includes/Admin/DocsContent.php:309
msgid "<strong>When deleting the plugin</strong> (off): also delete documents, categories, settings and (with Pro) logs. Leave off unless you are removing the plugin for good."
msgstr ""

#: includes/Admin/DocsContent.php:312
msgid "Settings → Access & Pro, Fields, License"
msgstr ""

#: includes/Admin/DocsContent.php:314
msgid "Access"
msgstr ""

#: includes/Admin/DocsContent.php:314
msgid "Restricted documents in lists (lock or hide), protect files automatically (on), share link lifetime (7 days)."
msgstr ""

#: includes/Admin/DocsContent.php:315
msgid "Secure viewer"
msgstr ""

#: includes/Admin/DocsContent.php:315
msgid "Which documents use it (off / restricted / all), watermark pattern, block downloads, stamp downloads."
msgstr ""

#: includes/Admin/DocsContent.php:316
msgid "Activity log"
msgstr ""

#: includes/Admin/DocsContent.php:316
msgid "Log activity, reading time, searches, logged-out visitors; keep entries for 365 days."
msgstr ""

#: includes/Admin/DocsContent.php:317
msgid "Email gate"
msgstr ""

#: includes/Admin/DocsContent.php:317
msgid "Default (off), organization field, heading, consent text, remember visitors (30 days), webhook, lead retention, new-lead email."
msgstr ""

#: includes/Admin/DocsContent.php:318
msgid "Review & submissions"
msgstr ""

#: includes/Admin/DocsContent.php:318
msgid "Review reminder emails and recipients; who can submit, new submission status, file types and size."
msgstr ""

#: includes/Admin/DocsContent.php:319
#: includes/Admin/DocsContent.php:470
msgid "Acknowledgements"
msgstr ""

#: includes/Admin/DocsContent.php:319
msgid "Default statement; reminder emails."
msgstr ""

#: includes/Admin/DocsContent.php:320
msgid "Notifications"
msgstr ""

#: includes/Admin/DocsContent.php:320
msgid "Webhook URLs, events and signing secret; Slack/Teams webhook and events; email subscriptions."
msgstr ""

#: includes/Admin/DocsContent.php:321
msgid "AI assistant"
msgstr ""

#: includes/Admin/DocsContent.php:321
msgid "On/off; allow restricted documents."
msgstr ""

#: includes/Admin/DocsContent.php:322
msgid "Documents per person per day (0 = no limit); Cloudflare Turnstile keys."
msgstr ""

#: includes/Admin/DocsContent.php:323
msgid "Fields"
msgstr ""

#: includes/Admin/DocsContent.php:323
msgid "Custom fields for documents."
msgstr ""

#: includes/Admin/DocsContent.php:324
msgid "License"
msgstr ""

#: includes/Admin/DocsContent.php:324
msgid "Licence key for updates."
msgstr ""

